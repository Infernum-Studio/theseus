# Infernum Launcher build values.
# .invalid domain never resolves, so any call to
# them fails instead of reaching Modrinth
MODRINTH_URL=https://disabled.invalid/
MODRINTH_API_BASE_URL=https://disabled.invalid/
SHARED_INSTANCES_API_BASE_URL=https://disabled.invalid/
MODRINTH_ARCHON_BASE_URL=https://disabled.invalid/
MODRINTH_API_URL=https://disabled.invalid/v2/
MODRINTH_API_URL_V3=https://disabled.invalid/v3/
MODRINTH_SOCKET_URL=wss://disabled.invalid/
MODRINTH_LAUNCHER_META_URL=https://launcher-meta.modrinth.com/
LAUNCHER_USER_AGENT_BASE=infernum-launcher
LAUNCHER_USER_AGENT_CONTACT=https://github.com/Infernum-Studio/Infernum-Launcher
